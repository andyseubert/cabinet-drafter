        face_low = low
        run_drawers.each_with_index do |d, idx|
          face_high = idx == run_drawers.length - 1 ? high : centers[idx] - (FRONT_GAP / 2.0)
          h = face_high - face_low
          raise "#{spec[:label]}: drawer-front reveal geometry leaves a non-positive face height" if h <= 0
          results << { drawer_index: d[:drawer_index], zone_index: d[:zone_index], z: face_low, height: h }
          face_low = centers[idx] + (FRONT_GAP / 2.0) if idx < run_drawers.length - 1
        end
      else
        hs = custom[custom_offset, run_drawers.length]
        used = hs.inject(0.0, :+)
        raise "#{spec[:label]}: custom drawer fronts exceed their available face region" if used > available + 0.001
        cursor = low
        run_drawers.each_with_index do |d, idx|
          h = hs[idx]
          results << { drawer_index: d[:drawer_index], zone_index: d[:zone_index], z: cursor, height: h }
          cursor += h + FRONT_GAP if idx < run_drawers.length - 1
        end
      end
      custom_offset += run_drawers.length
    end

    results.sort_by { |f| f[:drawer_index] }
  end

  # Models an open-top drawer box. Bottom is fully inside the four walls.
  # All five pieces are intended for pocket-screw assembly; no dado/rabbet.
  def make_drawer_box(parent, name, x, y, z, width, depth, height, birch)
    side = DRAWER_SIDE_PLY
    bottom = DRAWER_BOTTOM_PLY
    raise "#{name}: drawer box is too narrow" if width <= 2.0 * side
    raise "#{name}: drawer box is too shallow" if depth <= 2.0 * side
    raise "#{name}: drawer box height must exceed bottom thickness" if height <= bottom

    g = parent.add_group
    g.name = name
    e = g.entities
    add_box(e, 'Left Drawer Side', 0, 0, 0, side, depth, height, birch)
    add_box(e, 'Right Drawer Side', width - side, 0, 0, side, depth, height, birch)
    add_box(e, 'Drawer Front', side, 0, 0, width - (2.0 * side), side, height, birch)
    add_box(e, 'Drawer Back', side, depth - side, 0,
            width - (2.0 * side), side, height, birch)
    add_box(e, 'Drawer Bottom', side, side, 0,
            width - (2.0 * side), depth - (2.0 * side), bottom, birch)
    g.transform!(Geom::Transformation.translation([i(x), i(y), i(z)]))
    g
  end

  def add_drawer_mixed_contents(entities, width, spec, birch, cherry, open_back)
    layout = resolved_zone_layout(spec)
    fronts = resolved_front_layout(spec, layout)
    inside_w = width - (2.0 * PLY)
    box_w = inside_w - SLIDE_CLEARANCE_TOTAL
    raise "#{spec[:label]}: slide clearance leaves no drawer-box width" if box_w <= 0
    raise "#{spec[:label]}: drawer depth #{DRAWER_DEPTH} exceeds cabinet depth #{CAB_DEPTH}" if DRAWER_DEPTH > CAB_DEPTH

    z0 = KICK_HEIGHT
    x_box = PLY + (SLIDE_CLEARANCE_TOTAL / 2.0)
    front = front_rect(spec)
    front_w = front[:width]
    panel_depth = [MIXED_PANEL_DEPTH, CAB_DEPTH - PLY].min
    panel_mat = MIXED_PANEL_MATERIAL == :cherry ? cherry : birch
    panel_name = MIXED_PANEL_MATERIAL == :cherry ? 'Cherry' : 'Birch'

    layout[:dividers].each_with_index do |d, idx|
      add_box(entities, format('Open Cubby Divider %d - %s 3/4', idx + 1, panel_name),
              PLY, 0, z0 + d[:z], inside_w, panel_depth, PLY, panel_mat)
    end

    # Open cubbies get localized applied backs only where the open space exists.
    # Each back spans the full outside cabinet width and covers the clear opening
    # plus the thickness of the horizontal structure immediately below and above.
    layout[:opens].each_with_index do |o, idx|
      add_box(entities, format('Open Cubby Back %d - %s', idx + 1, OPEN_BACK_MATERIAL.to_s.capitalize),
              0, CAB_DEPTH, z0 + o[:clear_bottom] - PLY,
              width, BACK_PLY, o[:height] + (2.0 * PLY), open_back)
    end

    layout[:drawers].each do |d|
      position_name = if layout[:drawers].length == 1
                        'only'
                      elsif d[:drawer_index] == 0
                        'bottom'
                      elsif d[:drawer_index] == layout[:drawers].length - 1
                        'top'
                      else
                        'middle'
                      end
      make_drawer_box(entities,
                      format('Drawer Box %d (%s) - %.3g W x %.3g D x %.3g H', d[:drawer_index] + 1, position_name, box_w, DRAWER_DEPTH, d[:height]),
                      x_box, 0, z0 + d[:z], box_w, DRAWER_DEPTH, d[:height], birch)
    end

    front_map = {}
    fronts.each do |f|
      position_name = if fronts.length == 1
                        'only'
                      elsif f[:drawer_index] == 0
                        'bottom'
                      elsif f[:drawer_index] == fronts.length - 1
                        'top'
                      else
                        'middle'
                      end
      add_box(entities,
              format('Drawer Front %d (%s) - Cherry 3/4', f[:drawer_index] + 1, position_name),
              front[:x], front[:y], z0 + f[:z], front_w, PLY, f[:height], cherry)
      front_map[f[:drawer_index]] = f
    end

    layout[:drawers].each do |d|
      next unless (f = front_map[d[:drawer_index]])
      add_drawer_height_label(entities, d[:drawer_index], d[:height], f[:height],
                              front[:x] + (front_w / 2.0), front[:y] - 0.01,
                              z0 + f[:z] + (f[:height] / 2.0))
    end

    layout[:opens].each do |o|
      add_open_space_height_label(entities, o[:height], width / 2.0, -0.01,
                                  z0 + ((o[:clear_bottom] + o[:clear_top]) / 2.0))
    end

    [layout, fronts, box_w]
  end

  def add_single_door(entities, width, spec, cherry)
    z0 = KICK_HEIGHT
    front = front_rect(spec)
    name = spec[:front_style].to_sym == :face_inset ? 'Single Inset Door - Cherry 3/4' : 'Single Overlay Door - Cherry 3/4'
    add_box(entities, name, front[:x], front[:y], z0 + front[:low],
            front[:width], PLY, front[:high] - front[:low], cherry)
  end

  def make_drawer_cabinet(parent, x0, spec, birch, cherry, open_back, cherry_skin)
    width = spec[:width].to_f
    cab = parent.add_group
    cab.name = spec[:label].to_s
    e = cab.entities

    zones_for_material = normalized_zones(spec)
    mixed = zones_for_material.any? { |z| z[:kind] == :open }
    carcass = mixed ? cherry : birch
    carcass_name = mixed ? 'Cherry' : 'Birch'
    make_open_back_box(e, width, carcass, carcass_name, birch, cherry_skin)
    layout, fronts, box_w = add_drawer_mixed_contents(e, width, spec, birch, cherry, open_back)
    add_face_frame(e, width, spec, birch, cherry)
    stack_text = layout[:zones].map { |z| "#{z[:kind] == :drawer ? 'D' : 'O'}#{format_dimension(z[:height])}" }.join(', ')
    open_text = layout[:opens].map { |o| format_dimension(o[:height]) }.join(', ')

    add_label(e,
              format("%s\n%s W x %s D x %s H\nstack bottom->top: %s\n%d drawers | box %s W x %s D\nopen clear H: %s\n%d divider panel(s) | %s %s",
                     spec[:label], format_dimension(width), format_dimension(CAB_DEPTH), format_dimension(CAB_HEIGHT), stack_text,
                     layout[:drawers].length, format_dimension(box_w), format_dimension(DRAWER_DEPTH),
                     open_text.empty? ? 'none' : open_text,
                     layout[:dividers].length, layout[:remaining_context], format_dimension(layout[:remaining])),
              0, CAB_DEPTH + 2.0, KICK_HEIGHT + CAB_HEIGHT + 4.0)

    cab.transform!(Geom::Transformation.translation([i(x0), 0, 0]))
    cab
  end

