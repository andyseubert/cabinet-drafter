    const ce=Math.cos(preview3D.elev),cameraVec=[ce*Math.cos(preview3D.az),ce*Math.sin(preview3D.az),Math.sin(preview3D.elev)],forward=[-cameraVec[0],-cameraVec[1],-cameraVec[2]];let right=vcross(forward,[0,0,1]);if(Math.hypot(...right)<1e-5)right=[1,0,0];right=vnorm(right);const up=vnorm(vcross(right,forward));return {cameraVec,forward,right,up};
  }
  function previewProject(p,basis,width,height){const d=vsub(p,preview3D.target);return {x:(width/2)+preview3D.panX+vdot(d,basis.right)*preview3D.scale,y:(height/2)+preview3D.panY-vdot(d,basis.up)*preview3D.scale,depth:vdot(d,basis.forward)}}
  function previewBoxCorners(b){return [[b.x,b.y,b.z],[b.x+b.w,b.y,b.z],[b.x+b.w,b.y+b.d,b.z],[b.x,b.y+b.d,b.z],[b.x,b.y,b.z+b.h],[b.x+b.w,b.y,b.z+b.h],[b.x+b.w,b.y+b.d,b.z+b.h],[b.x,b.y+b.d,b.z+b.h]]}
  const previewFaceDefs=[{i:[0,1,5,4],n:[0,-1,0]},{i:[3,7,6,2],n:[0,1,0]},{i:[0,4,7,3],n:[-1,0,0]},{i:[1,2,6,5],n:[1,0,0]},{i:[0,3,2,1],n:[0,0,-1]},{i:[4,5,6,7],n:[0,0,1]}];
  function previewMaterialRgb(mat){if(mat==='cherryBack')return [173,107,70];if(mat==='birchBack')return [218,203,166];if(mat==='cherry')return [200,137,103];return [234,217,174]}
  function previewShade(mat,n){const base=previewMaterialRgb(mat),light=vnorm([-0.5,-0.8,1]),f=0.72+0.28*Math.max(0,vdot(n,light));return `rgb(${base.map(v=>Math.max(0,Math.min(255,Math.round(v*f)))).join(',')})`}
  function previewVisibleBoxes(){const showFronts=document.getElementById('previewShowFronts').checked,showDrawers=document.getElementById('previewShowDrawerBoxes').checked,showBacks=document.getElementById('previewShowBacks').checked;return preview3D.scene.boxes.filter(b=>(showFronts||b.category!=='front')&&(showDrawers||b.category!=='drawerBox')&&(showBacks||b.category!=='back'))}
  function previewResizeCanvas(){const r=previewCanvas.getBoundingClientRect(),dpr=Math.min(window.devicePixelRatio||1,2),w=Math.max(1,Math.round(r.width*dpr)),h=Math.max(1,Math.round(r.height*dpr));if(previewCanvas.width!==w||previewCanvas.height!==h){previewCanvas.width=w;previewCanvas.height=h}const ctx=previewCanvas.getContext('2d');ctx.setTransform(dpr,0,0,dpr,0,0);return {ctx,width:r.width,height:r.height,dpr}}
  function previewSceneBounds(includeLabels=true){const boxes=previewVisibleBoxes(),pts=[];boxes.forEach(b=>pts.push(...previewBoxCorners(b)));if(includeLabels)preview3D.scene.labels.forEach(l=>pts.push([l.x,l.y,l.z]));if(!pts.length)return {min:[0,0,0],max:[1,1,1]};const min=[Infinity,Infinity,Infinity],max=[-Infinity,-Infinity,-Infinity];pts.forEach(p=>{for(let k=0;k<3;k++){min[k]=Math.min(min[k],p[k]);max[k]=Math.max(max[k],p[k])}});return {min,max}}
  function fitPreview3D(){
    if(!previewCanvas)return;const {width,height}=previewResizeCanvas(),bounds=previewSceneBounds(true);preview3D.target=[(bounds.min[0]+bounds.max[0])/2,(bounds.min[1]+bounds.max[1])/2,(bounds.min[2]+bounds.max[2])/2];preview3D.panX=0;preview3D.panY=0;
    const basis=previewBasis(),corners=[];for(const x of [bounds.min[0],bounds.max[0]])for(const y of [bounds.min[1],bounds.max[1]])for(const z of [bounds.min[2],bounds.max[2]])corners.push([x,y,z]);const xs=[],ys=[];corners.forEach(p=>{const d=vsub(p,preview3D.target);xs.push(vdot(d,basis.right));ys.push(vdot(d,basis.up))});const spanX=Math.max(...xs)-Math.min(...xs)||1,spanY=Math.max(...ys)-Math.min(...ys)||1;preview3D.scale=Math.max(0.1,Math.min((width-60)/spanX,(height-60)/spanY));preview3D.fitted=true;renderPreview3D();
  }
  function drawPreviewLabel(ctx,label,p){
    const lines=String(label.text).split(/\n/),font=label.kind==='cabinet'?'600 13px -apple-system,BlinkMacSystemFont,Segoe UI,sans-serif':'600 12px -apple-system,BlinkMacSystemFont,Segoe UI,sans-serif';ctx.font=font;ctx.textAlign='center';ctx.textBaseline='middle';const lineH=15,w=Math.max(...lines.map(t=>ctx.measureText(t).width))+10,h=(lines.length*lineH)+6;ctx.fillStyle='rgba(255,255,255,.82)';ctx.fillRect(p.x-w/2,p.y-h/2,w,h);ctx.strokeStyle='rgba(255,255,255,.95)';ctx.lineWidth=3;ctx.fillStyle='#222';lines.forEach((t,i)=>{const yy=p.y+(i-(lines.length-1)/2)*lineH;ctx.strokeText(t,p.x,yy);ctx.fillText(t,p.x,yy)});
  }
  function renderPreview3D(){
    if(!previewCanvas)return;const {ctx,width,height}=previewResizeCanvas();ctx.clearRect(0,0,width,height);ctx.fillStyle='#f7f7f4';ctx.fillRect(0,0,width,height);if(!preview3D.scene.boxes.length){ctx.fillStyle='#666';ctx.textAlign='center';ctx.font='14px sans-serif';ctx.fillText('No cabinet geometry to preview.',width/2,height/2);return}
    const basis=previewBasis(),faces=[];for(const b of previewVisibleBoxes()){const c=previewBoxCorners(b);for(const f of previewFaceDefs){if(vdot(f.n,basis.cameraVec)<=0.0001)continue;const world=f.i.map(i=>c[i]),proj=world.map(p=>previewProject(p,basis,width,height)),depth=proj.reduce((a,p)=>a+p.depth,0)/proj.length;faces.push({pts:proj,depth,fill:previewShade(b.material,f.n),name:b.name})}}
    faces.sort((a,b)=>b.depth-a.depth);ctx.lineJoin='round';ctx.lineCap='round';for(const f of faces){ctx.beginPath();ctx.moveTo(f.pts[0].x,f.pts[0].y);for(let i=1;i<f.pts.length;i++)ctx.lineTo(f.pts[i].x,f.pts[i].y);ctx.closePath();ctx.fillStyle=f.fill;ctx.fill();ctx.strokeStyle='rgba(32,32,32,.78)';ctx.lineWidth=0.9;ctx.stroke()}
    const labels=preview3D.scene.labels.map(l=>({label:l,p:previewProject([l.x,l.y,l.z],basis,width,height)})).sort((a,b)=>b.p.depth-a.p.depth);labels.forEach(x=>drawPreviewLabel(ctx,x.label,x.p));
    const errors=preview3D.scene.errors.length?` · ${preview3D.scene.errors.length} preview warning(s)`:'';previewStatus.textContent=`${preview3D.scene.cabinetCount} cabinet(s) · ${preview3D.scene.boxes.length} modeled pieces${errors} · Drag to orbit · wheel to zoom · Shift-drag to pan · double-click to fit.`;
  }
  function update3DPreview(s=state()){preview3D.scene=buildPreviewScene(s);window.__cabinetDrafter3DScene=preview3D.scene;fitPreview3D()}
  function setPreviewView(view){if(view==='front'){preview3D.az=-Math.PI/2;preview3D.elev=0}else if(view==='left'){preview3D.az=Math.PI;preview3D.elev=0}else if(view==='right'){preview3D.az=0;preview3D.elev=0}else if(view==='top'){preview3D.az=-Math.PI/2;preview3D.elev=(Math.PI/2)-0.002}else{preview3D.az=-Math.PI/4;preview3D.elev=0.48}fitPreview3D()}
  document.querySelectorAll('[data-preview-view]').forEach(b=>b.addEventListener('click',()=>setPreviewView(b.dataset.previewView)));document.getElementById('previewFit').addEventListener('click',fitPreview3D);['previewShowFronts','previewShowDrawerBoxes','previewShowBacks'].forEach(id=>document.getElementById(id).addEventListener('change',()=>{fitPreview3D()}));
  previewCanvas.addEventListener('pointerdown',e=>{preview3D.dragging=true;preview3D.dragMode=(e.shiftKey||e.button===1)?'pan':'orbit';preview3D.lastX=e.clientX;preview3D.lastY=e.clientY;previewCanvas.classList.add('dragging');previewCanvas.setPointerCapture(e.pointerId)});
  previewCanvas.addEventListener('pointermove',e=>{if(!preview3D.dragging)return;const dx=e.clientX-preview3D.lastX,dy=e.clientY-preview3D.lastY;preview3D.lastX=e.clientX;preview3D.lastY=e.clientY;if(preview3D.dragMode==='pan'){preview3D.panX+=dx;preview3D.panY+=dy}else{preview3D.az-=dx*0.009;preview3D.elev=Math.max(-1.35,Math.min(1.35,preview3D.elev+dy*0.007))}renderPreview3D()});
  const endPreviewDrag=e=>{preview3D.dragging=false;previewCanvas.classList.remove('dragging');try{previewCanvas.releasePointerCapture(e.pointerId)}catch(_){}};previewCanvas.addEventListener('pointerup',endPreviewDrag);previewCanvas.addEventListener('pointercancel',endPreviewDrag);previewCanvas.addEventListener('contextmenu',e=>e.preventDefault());previewCanvas.addEventListener('dblclick',fitPreview3D);
  previewCanvas.addEventListener('wheel',e=>{e.preventDefault();preview3D.scale=Math.max(0.08,Math.min(250,preview3D.scale*Math.exp(-e.deltaY*0.001)));renderPreview3D()},{passive:false});
  document.getElementById('savePreviewPng').addEventListener('click',()=>{renderPreview3D();const a=document.createElement('a');a.href=previewCanvas.toDataURL('image/png');a.download='cabinet-drafter_3d_preview.png';document.body.appendChild(a);a.click();a.remove()});
  if('ResizeObserver' in window)new ResizeObserver(()=>{if(preview3D.scene.boxes.length)fitPreview3D()}).observe(previewWrap);else window.addEventListener('resize',()=>{if(preview3D.scene.boxes.length)fitPreview3D()});

  function updateAll(){const s=state();preview.value=generateRuby();updateAllRowBudgets();updateSummary();updateBomAndLayouts();update3DPreview(s);scheduleProjectAutosave()}
  function changed(){try{localStorage.setItem(STORAGE_KEY,JSON.stringify(state()))}catch(_){}updateAll()}
  function download(name,text,type='text/plain'){const blob=new Blob([text],{type}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),500)}
  document.getElementById('addDrawer').onclick=()=>{makeRow({label:'New Drawer / Mixed Cabinet',type:'drawer',frontStyle:'frameless',width:24,qty:1,stackSpec:'D7, D7, D7',frontHeights:[],shelves:0});changed()};
  document.getElementById('addDoor').onclick=()=>{makeRow({label:'New Single Door Cabinet',type:'door',frontStyle:'frameless',width:20,qty:1,stackSpec:'',frontHeights:[],shelves:0});changed()};
  document.getElementById('addShelf').onclick=()=>{makeRow({label:'New Open Shelf Cabinet',type:'open_shelf',frontStyle:'frameless',width:24,qty:1,stackSpec:'',frontHeights:[],shelves:2});changed()};
  document.getElementById('units').addEventListener('change',e=>{const st=state();activeUnits=e.target.value==='mm'?'mm':'in';st.units=activeUnits;applyState(st);try{localStorage.setItem(STORAGE_KEY,JSON.stringify(state()))}catch(_){}});
  ids.forEach(id=>document.getElementById(id).addEventListener('input',changed));document.getElementById('preserveCherryGrain').addEventListener('change',changed);document.getElementById('showLabels').addEventListener('change',changed);document.getElementById('showDrawerBoxHeightLabels').addEventListener('change',changed);document.getElementById('showDrawerFaceHeightLabels').addEventListener('change',changed);document.getElementById('showOpenSpaceHeightLabels').addEventListener('change',changed);
  function rubyTimestamp(){const d=new Date(),p=n=>String(n).padStart(2,'0');return `${d.getFullYear()}${p(d.getMonth()+1)}${p(d.getDate())}_${p(d.getHours())}${p(d.getMinutes())}${p(d.getSeconds())}`}
  document.getElementById('downloadRuby').onclick=async()=>{await flushProjectSave();const name=`cabinet-drafter_generated_${rubyTimestamp()}.rb`;download(name,generateRuby());const cmd=`load File.expand_path('~/Downloads/${name}')`;document.getElementById('rubyDownloadStatus').innerHTML=`Downloaded <strong>${esc(name)}</strong>. In SketchUp Ruby Console run: <code>${esc(cmd)}</code>`;};
  document.getElementById('copyRuby').onclick=async()=>{await flushProjectSave();try{await navigator.clipboard.writeText(generateRuby());alert('Ruby copied to clipboard.')}catch(_){preview.select();document.execCommand('copy');alert('Ruby copied to clipboard.')}};
  document.getElementById('saveProject').onclick=saveProject;
  document.getElementById('saveProjectAs').onclick=saveProjectAs;
  document.getElementById('downloadJson').onclick=()=>download('cabinet-drafter_project_export.json',projectJsonText(),'application/json');
  document.getElementById('downloadBom').onclick=downloadBomCsv;document.getElementById('downloadCutList').onclick=downloadCutListCsv;document.getElementById('downloadLinearStock').onclick=downloadLinearStockCsv;
  document.getElementById('printLayouts').onclick=()=>{document.body.classList.add('print-layouts');window.print();setTimeout(()=>document.body.classList.remove('print-layouts'),500)};
  document.getElementById('loadJson').onclick=()=>document.getElementById('jsonFile').click();
  document.getElementById('jsonFile').addEventListener('change',async e=>{const file=e.target.files[0];if(!file)return;try{const s=JSON.parse(await file.text());applyState({...defaults,...s});try{localStorage.setItem(STORAGE_KEY,JSON.stringify(state()))}catch(_){} }catch(err){alert('Could not load settings: '+err.message)}e.target.value=''});
  document.getElementById('reset').onclick=()=>{if(confirm('Reset all cabinet settings to the supplied defaults?')){try{localStorage.removeItem(STORAGE_KEY)}catch(_){}applyState(deepCopy(defaults));changed()}};
const helpDialog=document.getElementById('helpDialog');
  document.getElementById('openHelp').onclick=()=>{if(helpDialog.showModal)helpDialog.showModal();else helpDialog.setAttribute('open','')};
  document.getElementById('closeHelp').onclick=()=>{if(helpDialog.close)helpDialog.close();else helpDialog.removeAttribute('open')};
  helpDialog.addEventListener('click',e=>{if(e.target===helpDialog){if(helpDialog.close)helpDialog.close();else helpDialog.removeAttribute('open')}});
  let initial=deepCopy(defaults);try{let saved=localStorage.getItem(STORAGE_KEY),fromOld=false;if(!saved){for(const k of OLD_KEYS){saved=localStorage.getItem(k);if(saved){fromOld=true;break}}}if(saved){const prior=JSON.parse(saved);if(fromOld){prior.mixedPanelMaterial=prior.mixedPanelMaterial||'cherry';prior.openBackMaterial=prior.openBackMaterial||'cherry';if(Array.isArray(prior.cabinets))prior.cabinets=prior.cabinets.map(c=>({...c,frontStyle:c.frontStyle||'frameless'}))}initial={...initial,...prior}}}catch(_){}applyState(initial);initProjectFile();
})();
