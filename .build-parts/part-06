    raise "#{spec[:label]} drawer/mixed cabinet needs at least one drawer" unless zones.any? { |z| z[:kind] == :drawer }
    zones.each_cons(2) do |a, b|
      raise "#{spec[:label]}: adjacent open cubbies should be combined into one larger open cubby" if a[:kind] == :open && b[:kind] == :open
    end
    zones
  end

  # Resolve all vertical structure inside a drawer/mixed cabinet.
  # Coordinates here are relative to the bottom of the 38in carcass (not the toe kick).
  # Open-zone heights are CLEAR opening heights.
  # - Bottom open zone: cabinet bottom is its lower shelf; only a top divider is added.
  # - Middle open zone: bottom and top dividers are added.
  # - Top open zone: only a bottom divider is added and the clear opening is anchored
  #   to the underside of the top stretchers so the entered height is exact.
  def resolved_zone_layout(spec)
    zones = normalized_zones(spec)
    internal_bottom = PLY
    internal_top = CAB_HEIGHT - PLY
    usable = internal_top - internal_bottom
    raise "#{spec[:label]}: cabinet leaves no usable internal height" if usable <= 0

    drawers = []
    opens = []
    dividers = []
    drawer_index = 0
    cursor = internal_bottom
    top_open = zones.last[:kind] == :open
    process_count = top_open ? zones.length - 1 : zones.length

    (0...process_count).each do |idx|
      zone = zones[idx]
      if idx == 0
        cursor += DRAWER_BOTTOM_CLEARANCE if zone[:kind] == :drawer
      else
        prev = zones[idx - 1]
        case [prev[:kind], zone[:kind]]
        when [:drawer, :drawer]
          cursor += DRAWER_BOX_GAP
        when [:drawer, :open]
          cursor += DRAWER_BOX_GAP
          dividers << { z: cursor, boundary: 'bottom of open cubby' }
          cursor += PLY
        when [:open, :drawer]
          dividers << { z: cursor, boundary: 'top of open cubby' }
          cursor += PLY + DRAWER_BOX_GAP
        else
          raise "#{spec[:label]}: adjacent open cubbies should be combined"
        end
      end

      if zone[:kind] == :drawer
        drawers << { zone_index: idx, drawer_index: drawer_index, z: cursor, height: zone[:height] }
        drawer_index += 1
        cursor += zone[:height]
      else
        opens << { zone_index: idx, clear_bottom: cursor, clear_top: cursor + zone[:height], height: zone[:height] }
        cursor += zone[:height]
      end
    end

    remaining = 0.0
    remaining_context = 'unused above stack'
    if top_open
      raise "#{spec[:label]}: an all-open cabinet should use the Open Shelf type" if zones.length < 2
      top_height = zones.last[:height]
      divider_z = internal_top - top_height - PLY
      prev = zones[-2]
      raise "#{spec[:label]}: adjacent open cubbies should be combined" if prev[:kind] == :open
      min_divider_z = cursor + DRAWER_BOX_GAP
      if divider_z < min_divider_z - 0.001
        raise "#{spec[:label]}: stack exceeds available height by #{format_dimension(min_divider_z - divider_z)}"
      end
      remaining = [divider_z - min_divider_z, 0.0].max
      remaining_context = 'extra hidden clearance below top cubby'
      dividers << { z: divider_z, boundary: 'bottom of top open cubby' }
      opens << { zone_index: zones.length - 1,
                 clear_bottom: divider_z + PLY,
                 clear_top: internal_top,
                 height: top_height }
    else
      remaining = internal_top - cursor
      if remaining < -0.001
        raise "#{spec[:label]}: stack exceeds internal vertical space by #{format_dimension(-remaining)}"
      end
      remaining = [remaining, 0.0].max
    end

    { zones: zones, drawers: drawers, opens: opens, dividers: dividers,
      usable: usable, remaining: remaining, remaining_context: remaining_context }
  end

  def face_frame?(spec)
    [:face_overlay, :face_inset].include?(spec[:front_style].to_sym)
  end

  def frame_opening(spec)
    { x: FRAME_STILE_WIDTH, z: FRAME_RAIL_WIDTH,
      width: spec[:width].to_f - (2.0 * FRAME_STILE_WIDTH),
      height: CAB_HEIGHT - (2.0 * FRAME_RAIL_WIDTH) }
  end

  def front_rect(spec)
    style = (spec[:front_style] || :frameless).to_sym
    width = spec[:width].to_f
    if style == :face_overlay
      o = frame_opening(spec)
      { x: o[:x] - FRAME_OVERLAY, width: o[:width] + (2.0 * FRAME_OVERLAY),
        y: -(FRAME_THICKNESS + PLY), low: o[:z] - FRAME_OVERLAY, high: o[:z] + o[:height] + FRAME_OVERLAY }
    elsif style == :face_inset
      o = frame_opening(spec)
      { x: o[:x] + FRAME_INSET_REVEAL, width: o[:width] - (2.0 * FRAME_INSET_REVEAL),
        y: -FRAME_THICKNESS, low: o[:z] + FRAME_INSET_REVEAL, high: o[:z] + o[:height] - FRAME_INSET_REVEAL }
    else
      { x: SIDE_REVEAL, width: width - (2.0 * SIDE_REVEAL), y: -PLY, low: FRONT_GAP, high: CAB_HEIGHT - FRONT_GAP }
    end
  end

  def add_face_frame(entities, width, spec, birch, cherry)
    return unless face_frame?(spec)
    raise "#{spec[:label]}: face-frame stiles leave no rail length" if width <= 2.0 * FRAME_STILE_WIDTH
    mat = FRAME_MATERIAL == :birch ? birch : cherry
    wood = FRAME_MATERIAL == :birch ? 'Birch' : 'Cherry'
    z0 = KICK_HEIGHT
    rail_len = width - (2.0 * FRAME_STILE_WIDTH)
    add_box(entities, "Face Frame Left Stile - #{wood}", 0, -FRAME_THICKNESS, z0, FRAME_STILE_WIDTH, FRAME_THICKNESS, CAB_HEIGHT, mat)
    add_box(entities, "Face Frame Right Stile - #{wood}", width - FRAME_STILE_WIDTH, -FRAME_THICKNESS, z0, FRAME_STILE_WIDTH, FRAME_THICKNESS, CAB_HEIGHT, mat)
    add_box(entities, "Face Frame Bottom Rail - #{wood}", FRAME_STILE_WIDTH, -FRAME_THICKNESS, z0, rail_len, FRAME_THICKNESS, FRAME_RAIL_WIDTH, mat)
    add_box(entities, "Face Frame Top Rail - #{wood}", FRAME_STILE_WIDTH, -FRAME_THICKNESS, z0 + CAB_HEIGHT - FRAME_RAIL_WIDTH, rail_len, FRAME_THICKNESS, FRAME_RAIL_WIDTH, mat)
  end

  # Drawer-front face layout is independent of drawer-box height.
  # Each contiguous run of drawers fills the visible face region between open cubbies.
  def resolved_front_layout(spec, layout)
    drawers = layout[:drawers]
    count = drawers.length
    custom = Array(spec[:front_heights]).map(&:to_f).select { |v| v > 0 }
    if !custom.empty? && custom.length != count
      raise "#{spec[:label]}: custom front-height count must match drawer count"
    end

    open_by_zone = {}
    layout[:opens].each { |o| open_by_zone[o[:zone_index]] = o }
    drawer_by_zone = {}
    drawers.each { |d| drawer_by_zone[d[:zone_index]] = d }

    runs = []
    current = []
    layout[:zones].each_with_index do |zone, idx|
      if zone[:kind] == :drawer
        current << idx
      elsif !current.empty?
        runs << current
        current = []
      end
    end
    runs << current unless current.empty?

    results = []
    custom_offset = 0
    runs.each do |run|
      first_zone = run.first
      last_zone = run.last
      outer = front_rect(spec)
      low = first_zone == 0 ? outer[:low] : open_by_zone[first_zone - 1][:clear_top] + FRONT_GAP
      high = last_zone == layout[:zones].length - 1 ? outer[:high] : open_by_zone[last_zone + 1][:clear_bottom] - FRONT_GAP
      run_drawers = run.map { |zi| drawer_by_zone[zi] }
      available = high - low - ((run_drawers.length - 1) * FRONT_GAP)
      box_sum = run_drawers.inject(0.0) { |sum, d| sum + d[:height] }
      raise "#{spec[:label]}: no visible face height remains for a drawer run" if available <= 0

      if custom.empty?
        # Keep reveal lines tied to the physical drawer stack instead of
        # redistributing spare face height across all drawers.  Boundaries between
        # adjacent drawer fronts are centered in the actual drawer-box gaps, so a
        # shared bottom-up drawer prefix aligns across neighboring cabinets even
        # when one cabinet changes to an open cubby above it.
        centers = []
        (0...(run_drawers.length - 1)).each do |idx|
          a = run_drawers[idx]
          b = run_drawers[idx + 1]
          centers << (((a[:z] + a[:height]) + b[:z]) / 2.0)
        end

